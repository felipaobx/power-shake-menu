# URL de conexão fornecida pelo armazenamento Redis da implantação.
REDIS_URL=redis://usuario:senha@host:porta

# PIN inicial do administrador. Use pelo menos 8 caracteres aleatórios.
ADMIN_PIN=troque-por-um-pin-forte

# Origem pública exata, sem barra no final.
APP_ORIGIN=https://seu-dominio.example
